# ==============================================================================
# AI ScholarTwin — Environment Variables Template (Milestone 2)
# DO NOT COMMIT SENSITIVE PRODUCTION CREDENTIALS
# ==============================================================================

# Backend Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/ai_scholartwin?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=scholartwin_user
SPRING_DATASOURCE_PASSWORD=your_database_password_here

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_minimum_256_bits_length
JWT_EXPIRATION_MS=86400000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend Configuration
VITE_BACKEND_URL=http://localhost:8080

# Document Storage & Extraction (Milestone 4)
DOCUMENT_STORAGE_DIR=uploads/documents
DOCUMENT_MAX_FILE_SIZE=25MB
DOCUMENT_MAX_REQUEST_SIZE=30MB
DOCUMENT_MAX_PAGE_COUNT=100
DOCUMENT_CHUNK_MAX_SIZE=1000
DOCUMENT_CHUNK_OVERLAP=150
OCR_ENABLED=true
TESSERACT_PATH=tesseract
OCR_LANGUAGE=eng


