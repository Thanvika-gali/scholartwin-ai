# ==============================================================================
# AI ScholarTwin — Complete Environment Configuration Template (Milestone 10)
# DO NOT COMMIT ACTUAL PRODUCTION CREDENTIALS TO VERSION CONTROL
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Spring Boot Backend Server
# ------------------------------------------------------------------------------
PORT=8080
SPRING_PROFILES_ACTIVE=prod

# ------------------------------------------------------------------------------
# 2. MySQL Database Configuration
# ------------------------------------------------------------------------------
# For local development outside Docker:
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/ai_scholartwin?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=scholartwin_user
SPRING_DATASOURCE_PASSWORD=scholartwin_password

# For Docker Compose deployments (internal network):
# SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/ai_scholartwin?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# SPRING_DATASOURCE_USERNAME=scholartwin_user
# SPRING_DATASOURCE_PASSWORD=scholartwin_password

# Root password for MySQL Docker container initialization:
MYSQL_ROOT_PASSWORD=scholartwin_root_password
MYSQL_DATABASE=ai_scholartwin
MYSQL_USER=scholartwin_user
MYSQL_PASSWORD=scholartwin_password

# ------------------------------------------------------------------------------
# 3. JWT Security Configuration
# ------------------------------------------------------------------------------
# Must be at least 256 bits (32 characters or hex string) for HMAC-SHA256
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# 4. CORS Allowed Origins
# ------------------------------------------------------------------------------
# Comma-separated list of allowed web origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost

# ------------------------------------------------------------------------------
# 5. Document Processing & File Storage Limits
# ------------------------------------------------------------------------------
DOCUMENT_STORAGE_DIR=uploads/documents
DOCUMENT_MAX_FILE_SIZE=100MB
DOCUMENT_MAX_REQUEST_SIZE=110MB
DOCUMENT_MAX_FILE_SIZE_BYTES=104857600
DOCUMENT_MAX_PAGE_COUNT=200
DOCUMENT_CHUNK_MAX_SIZE=1000
DOCUMENT_CHUNK_OVERLAP=150

# Resume uploads
RESUME_MAX_FILE_SIZE_BYTES=20971520

# OCR (Tesseract)
OCR_ENABLED=true
TESSERACT_PATH=tesseract
OCR_LANGUAGE=eng

# ------------------------------------------------------------------------------
# 6. Google Gemini AI Integration
# ------------------------------------------------------------------------------
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 7. Frontend Client Configuration
# ------------------------------------------------------------------------------
# Leave empty for relative proxy (/api), or specify full backend URL if hosted separately
VITE_BACKEND_URL=http://localhost:8080
VITE_API_BASE_URL=
