# ============================================
# AI ScholarTwin — Root Git Ignore
# ============================================

# Build outputs
target/
dist/
build/
*.class

# Node / Frontend dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment & Secrets (NEVER COMMIT SECRETS)
.env
.env*.local
*.key
*.pem

# IDE & Editor Temporary Files
.idea/
.vscode/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/
.antigravity/

# OS Specific
Thumbs.db
Desktop.ini
.DS_Store

# Logs
logs/
*.log

# Maven temporary files
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar
